# Copie para .env.local e preencha. Nunca commite .env.local.

# Segredo que assina/criptografa o cookie de sessão (Auth.js).
# Gere com: npx auth secret   (ou qualquer string aleatória de 32+ bytes em base64)
AUTH_SECRET=

# Postgres gerenciado (Neon ou Supabase), ex.: postgres://usuario:senha@host/banco?sslmode=require
# Deixe vazio para usar o PGlite local (Postgres embutido salvo em ./.pglite).
DATABASE_URL=

# --- Open Finance (fase 3) ---
# Chaves da aplicação no painel da Pluggy (dashboard.pluggy.ai). Sem elas: banco simulado em desenvolvimento,
# e "Open Finance não configurado" em produção.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# true = o widget mostra os bancos de teste da Pluggy (sandbox: usuário user-ok, senha password-ok)
PLUGGY_SANDBOX=false
# Chave para criptografar o id das conexões no banco (gere como o AUTH_SECRET). Não troque depois de usar.
ENCRYPTION_KEY=
# A Vercel manda "Authorization: Bearer <CRON_SECRET>" na sincronização diária (vercel.json)
CRON_SECRET=

# Só se hospedar fora da Vercel, atrás de proxy:
# AUTH_TRUST_HOST=true
